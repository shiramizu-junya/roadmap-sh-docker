# ============================================================
# Dockerfile — イメージ（型）の作り方を書いたレシピ
#
# このファイル自体は「ただの文章」で、置いただけでは何も起きない。
# docker build を打つと、ここに書いた手順どおりにイメージが作られる。
#
#   Dockerfile  →  イメージ（型）  →  コンテナ（実物）
#   レシピ          docker build      docker run
#
# 上から順に実行される。1つの命令が1つの層（レイヤ）を作る。
# 詳しい解説: docs/p2-dockerfile.md
# ============================================================


# ------------------------------------------------------------
# FROM — どの型を土台にするか
# ------------------------------------------------------------
# 【いつ】ビルド時。いちばん最初に必ず書く
# 【何を】python:3.12-slim という既成の型の上に、自分の分を足していく
#         ゼロから作らない。カレーで言えば「市販のルウを使う」宣言
#
# 中身は Debian（Linux の一種）に Python を足したもの。
# この時点で OS の上半分（コマンドや道具）が入っている。
# カーネル（下半分）は入っていない。動かすときにホストから借りる。
#
# slim = 余計な道具を削った軽い版。
#   python:3.12        → 約 1GB
#   python:3.12-slim   → 約 205MB  ← これを使う
#
# ★ 版を固定する理由
#   手元の .python-version と pyproject.toml も 3.12 にそろえてある。
#   ここがずれると「手元では動くのにコンテナで動かない」が起きる。
#
# ★ docker pull は要らない
#   手元に無ければ docker build が自動で取りに行く。
FROM python:3.12-slim


# ------------------------------------------------------------
# WORKDIR — イメージの中での「作業場所」を決める
# ------------------------------------------------------------
# 【いつ】ビルド時に決まり、ランタイム時にも効く
# 【何を】これ以降の命令が、すべて /app の中で実行されるようになる
#
# 「この部屋で作業します」という宣言。存在しなければ作られる。
#
# 効果は2つある。
#   1. このあとの COPY の行き先が /app になる（短く書ける）
#   2. docker run したとき、コンテナの中の現在地が /app になる
#      → docker run --rm <イメージ> pwd  で確認できる
#
# ★ cd との違い
#   RUN cd /app と書いても、その行だけで終わってしまう。
#   WORKDIR は以降ずっと効き続ける。
WORKDIR /app

COPY requirements.txt .

RUN pip install --no-cache-dir -r requirements.txt

# ------------------------------------------------------------
# COPY — 手元のファイルをイメージの中に写す
# ------------------------------------------------------------
# 【いつ】ビルド時だけ。動かしている間は写されない
# 【何を】手元の app/ の「中身」を、作業場所（/app）へ写す
#
#   COPY  app/   .
#         ↑      ↑
#      写す元    写す先（. は WORKDIR で決めた /app のこと）
#
# app/ の「中身」が写るので、/app/main.py になる。
# /app/app/main.py にはならない。
#
# ★ ビルド時だけ、が大事
#   ビルドしたあとに手元の main.py を直しても、イメージの中身は変わらない。
#   イメージは読むだけで変わらないため（docs/p1-container-basics.md P1-5）。
#   直したら、もう一度 docker build する。
#
# ★ 送られる量は書き方で変わる
#   COPY app/ .   と書くと app/ だけが送られる（56B）
#   COPY . /app   と書くと .git や docs まで送られる（12.59MB）
#   いらないものは .dockerignore に書いて除ける。
#
# ★ ビルドコンテキストの外は写せない
#   COPY ../secret.txt . のような書き方は必ず失敗する。
#   docker build の最後に渡したフォルダの外は見えない。
COPY app/ .


# ------------------------------------------------------------
# CMD — コンテナが動き出したときに実行するコマンド
# ------------------------------------------------------------
# 【いつ】書くのはビルド時、実行されるのはランタイム時  ← ここがずれやすい
# 【何を】「何も言われなければ、これを実行する」という既定値
#
# ビルド中にこの python が走るわけではない。
# イメージの中に「動き出したらこれを実行せよ」とメモが書かれるだけ。
# そのため書き間違えてもビルドは通り、docker run して初めて落ちる。
#
#   CMD ["python", "-c", "import main; ..."]
#         ↑         ↑     ↑
#      プログラム  引数1  引数2
#
#   ターミナルで打つとこうなる:
#     python -c "import main; ..."
#
# ★ 書かないとどうなるか
#   土台（python:3.12-slim）の CMD をそのまま引き継ぐ。
#   python:3.12-slim の CMD は ["python3"] なので、対話画面が立ち上がって
#   すぐ終わる。アプリは動かないのに、エラーも出ず終了コードは 0 になる。
#   → 「動いていないのに成功に見える」のがいちばん厄介
#
# ★ あとから上書きできる
#   docker run --rm <イメージ> ls   のように、うしろにコマンドを書くと
#   CMD を無視してそちらが実行される。中を覗くときに便利。
#
# ★ いまは動作確認用の仮の内容
#   main.py を読み込めるかだけを確かめている。
#   P2-3 で fastapi を入れたあと、uvicorn でサーバを起動する形に変える。
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
